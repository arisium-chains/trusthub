{
  "collections": [
    {
      "name": "apps",
      "type": "base",
      "schema": [
        { "name": "name", "type": "text", "required": true },
        { "name": "slug", "type": "text", "required": true, "options": { "pattern": "^[a-z0-9-]+$" } },
        { "name": "category", "type": "text" },
        { "name": "chain", "type": "text" }
      ]
    },
    {
      "name": "reviews",
      "type": "base",
      "schema": [
        { "name": "app", "type": "relation", "required": true, "options": { "collectionName": "apps" } },
        { "name": "user", "type": "relation", "required": true, "options": { "collectionName": "users" } },
        { "name": "rating", "type": "number", "required": true },
        { "name": "comment", "type": "text", "required": true },
        { "name": "txHash", "type": "text" },
        { "name": "status", "type": "select", "required": true, "options": { "values": ["pending", "approved", "rejected", "shadowbanned"] } }
      ]
    },
    {
      "name": "aggregates",
      "type": "base",
      "schema": [
        { "name": "app", "type": "relation", "required": true, "options": { "collectionName": "apps" } },
        { "name": "score", "type": "number", "required": true }
      ]
    },
    {
      "name": "audit_logs",
      "type": "base",
      "schema": [
        { "name": "type", "type": "text", "required": true },
        { "name": "ref", "type": "text" },
        { "name": "status", "type": "text" },
        { "name": "reason", "type": "text" }
      ]
    }
  ]
}
